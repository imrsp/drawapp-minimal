{
  "name": "drawapp-minimal",
  "productName": "drawapp-minimal",
  "version": "1.0.0",
  "description": "drawapp-minimal desktop diagram editor",
  "exports": "./src/main/electron.js",
  "type": "module",
  "main": "src/main/electron.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test src/test/cli-args.test.js src/test/msi-project-created.test.js src/test/window-bounds.test.js src/test/window-lifecycle.test.js",
    "build:mac": "electron-builder --config electron-builder-linux-mac.json --mac dir --publish never",
    "build:win": "electron-builder --config electron-builder-win.json --publish never",
    "build:win-arm64": "electron-builder --config electron-builder-win-arm64.json --publish never",
    "build:appx": "electron-builder --config electron-builder-appx.json --publish never",
    "build:linux": "electron-builder --config electron-builder-linux-mac.json --linux --publish never",
    "build:snap": "electron-builder --config electron-builder-snap.json --publish never"
  },
  "keywords": [
    "drawapp-minimal",
    "diagram",
    "flowchart",
    "UML"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.3",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "crc": "^4.3.2",
    "electron-context-menu": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.7",
    "quicklookjs": "^1.0.1",
    "sumchecker": "^3.0.1"
  }
}
