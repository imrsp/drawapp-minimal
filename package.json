{
  "name": "drawapp-minimal",
  "productName": "DrawApp",
  "version": "1.0.0",
  "description": "DrawApp desktop diagram editor",
  "exports": "./src/main/electron.js",
  "type": "module",
  "main": "src/main/electron.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test src/test/branding.test.js src/test/cli-args.test.js src/test/msi-project-created.test.js src/test/window-bounds.test.js src/test/window-lifecycle.test.js",
    "build:mac": "node scripts/build.js mac",
    "build:win": "node scripts/build.js win",
    "build:win-arm64": "node scripts/build.js winArm64",
    "build:appx": "node scripts/build.js appx",
    "build:linux": "node scripts/build.js linux",
    "build:snap": "node scripts/build.js snap"
  },
  "keywords": [
    "drawapp-minimal",
    "diagram",
    "flowchart",
    "UML"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.3",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "crc": "^4.3.2",
    "electron-context-menu": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.7",
    "quicklookjs": "^1.0.1",
    "sumchecker": "^3.0.1"
  }
}
